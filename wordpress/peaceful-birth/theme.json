{
	"$schema": "https://schemas.wp.org/wp/6.4/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"layout": { "contentSize": "760px", "wideSize": "1140px" },
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "cream", "color": "#fbf6ef", "name": "Cream" },
				{ "slug": "sand", "color": "#f3e7d9", "name": "Sand" },
				{ "slug": "peach", "color": "#f2c79b", "name": "Peach" },
				{ "slug": "clay", "color": "#d79b72", "name": "Clay" },
				{ "slug": "terracotta", "color": "#b8693f", "name": "Terracotta" },
				{ "slug": "brown", "color": "#8e4a2a", "name": "Brown" },
				{ "slug": "cocoa", "color": "#4a2c1e", "name": "Cocoa" }
			]
		},
		"typography": { "dropCap": false }
	},
	"styles": {
		"spacing": { "blockGap": "0px" }
	}
